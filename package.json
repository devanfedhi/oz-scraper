{
  "name": "oz-scraper",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "docker:start": "docker compose up -d --build",
    "docker:infra": "docker compose up -d db liquibase restate-server",
    "docker:stop": "docker compose down",
    "restate:dev": "node scripts/restate-dev.mjs",
    "restate:health": "curl --fail --silent --show-error http://localhost:9070/health",
    "restate:logs": "docker compose logs -f restate-server restate-app restate-register"
  },
  "devDependencies": {
    "prettier": "3.9.4",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
